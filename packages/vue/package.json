{
  "name": "@vii/vue",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Experimental Vue adapter for the Vii Core readable-state contract.",
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run --config ../../vitest.config.ts",
    "build": "tsc -p tsconfig.build.json"
  },
  "peerDependencies": {
    "@vii/core": ">=0.0.0",
    "vue": ">=3.2.0"
  },
  "devDependencies": {
    "@vii/core": "workspace:*",
    "vue": "3.5.41"
  },
  "vii": {
    "stability": "experimental",
    "runtime": "vue-adapter"
  }
}
