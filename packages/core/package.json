{
  "name": "@vii/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Runtime-neutral Vii foundation package under Phase 0 bootstrap.",
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run --config ../../vitest.config.ts",
    "build": "tsc -p tsconfig.build.json",
    "validate-package": "node ../../scripts/package-validation/validate-package.mjs"
  },
  "vii": {
    "stability": "experimental",
    "runtime": "runtime-neutral"
  }
}
