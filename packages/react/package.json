{
  "name": "@vii/react",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Experimental React adapter for the Vii Core external-store contract.",
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run --config ../../vitest.config.ts",
    "build": "tsc -p tsconfig.build.json"
  },
  "peerDependencies": {
    "@vii/core": ">=0.0.0",
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/react-test-renderer": "19.0.0",
    "@vii/core": "workspace:*",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-test-renderer": "19.2.8"
  },
  "vii": {
    "stability": "experimental",
    "runtime": "react-adapter"
  }
}
