{
  "name": "@vii-labs/cli-core",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Experimental project detection and deterministic mutation engine for the Vii CLI.",
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run --config ../../vitest.config.ts",
    "build": "tsc -p tsconfig.build.json"
  },
  "peerDependencies": {
    "@vii-labs/core": ">=0.0.0"
  },
  "devDependencies": {
    "@vii-labs/core": "workspace:*",
    "@types/node": "22.17.0"
  },
  "vii": {
    "stability": "experimental",
    "runtime": "node-cli-core"
  }
}
