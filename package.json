{
  "name": "vii",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.12.4"
  },
  "scripts": {
    "format": "prettier --write \"**/*.{js,mjs,cjs,ts,mts,json,jsonc,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,cjs,ts,mts,json,jsonc,yaml,yml}\"",
    "lint": "eslint eslint.config.mjs scripts vitest.config.ts && nx run-many --target=lint --all",
    "typecheck": "nx run-many --target=typecheck --all",
    "test": "nx run-many --target=test --all",
    "test:browser": "nx test-browser form",
    "build": "nx run-many --target=build --all",
    "changeset": "changeset",
    "version:packages": "changeset version",
    "release:core:check": "node scripts/release-validation/validate-core-release-candidate.mjs",
    "benchmark:core": "pnpm --filter @vii-labs/core build && node scripts/benchmarks/core-state-baseline.mjs",
    "pack:check": "node scripts/package-validation/validate-package.mjs && node scripts/package-validation/validate-cli-core.mjs && node scripts/package-validation/validate-form.mjs",
    "check": "pnpm validate",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm pack:check"
  },
  "devDependencies": {
    "@angular/common": "22.1.4",
    "@angular/compiler": "22.1.4",
    "@angular/core": "22.1.4",
    "@angular/forms": "22.1.4",
    "@angular/platform-browser": "22.1.4",
    "@axe-core/playwright": "^4.13.0",
    "@changesets/cli": "^3.0.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.62.1",
    "@sinclair/typebox": "^0.34.52",
    "@standard-schema/spec": "^1.1.0",
    "@tanstack/react-form": "1.33.5",
    "arktype": "^2.2.3",
    "axios": "1.18.0",
    "eslint": "10.8.0",
    "ky": "1.7.5",
    "nx": "23.1.0",
    "ofetch": "1.4.1",
    "prettier": "3.9.6",
    "react-hook-form": "7.86.0",
    "rxjs": "7.8.2",
    "typescript": "6.0.2",
    "typescript-eslint": "8.65.0",
    "valibot": "^1.4.2",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "zod": "^4.4.3"
  },
  "pnpm": {
    "overrides": {
      "axios": "1.18.0",
      "brace-expansion": "5.0.9"
    }
  }
}
