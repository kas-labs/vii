{
  "name": "@vii/core",
  "version": "0.1.0-experimental.0",
  "private": false,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Experimental runtime-neutral State, Scope, and diagnostics primitives for TypeScript.",
  "keywords": [
    "state",
    "reactivity",
    "typescript",
    "lifecycle",
    "diagnostics"
  ],
  "homepage": "https://github.com/kas-labs/vii#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kas-labs/vii.git"
  },
  "bugs": {
    "url": "https://github.com/kas-labs/vii/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "files": [
    "CHANGELOG.md",
    "dist",
    "README.md",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run --config ../../vitest.config.ts",
    "build": "tsc -p tsconfig.build.json",
    "validate-package": "node ../../scripts/package-validation/validate-package.mjs"
  },
  "vii": {
    "stability": "experimental",
    "runtime": "runtime-neutral"
  }
}
